# Secrets. Only the .example variants belong in git.
.env
.env.local
.env.*.local
*.key
*.pem

# Python artefacts left behind by the tools/ scripts.
__pycache__/
*.pyc

# Editor and OS noise.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Machine-local Claude Code settings. The shared .claude/ content is committed.
.claude/settings.local.json

# The task report is ephemeral by design: generated on demand, never committed.
context/tasks/_today.md

# context-graph's local state — graph, hash cache and report. Regenerable from the
# working tree, so history carries the cause and not the effect; and a committed state
# file would be a conflict factory in a repo worked on from several sessions at once.
# The working tree and not the index on purpose: a file written and not yet staged is
# already a node, so what is regenerated can differ from what a commit would contain —
# one more reason this belongs nowhere near history. Rebuilt by any query (see
# tools/context-graph/README.md).
context/.graph/
